# Copy to .env.local and fill in. Local Supabase values: run `npm run sb:start`
# (or `npx supabase status`) and copy API URL / anon key / service_role key.

# App data DB. Dev: the Postgres inside local Supabase. (Tests use docker h2h_test via .env.test.)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase API URL (local default http://127.0.0.1:54321) and keys from `supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app (used in email links)
APP_URL=http://localhost:3000

# Comma-separated admin emails (case-insensitive)
ADMIN_EMAILS=admin@example.com

# Email (Resend). RESEND_API_KEY is optional: leave empty in dev to skip sending.
EMAIL_FROM=HomeToHome <onboarding@resend.dev>
RESEND_API_KEY=

# Optional: Kakao REST API key (address lookup)
KAKAO_REST_API_KEY=

# Supabase Storage bucket for room photos
PHOTO_BUCKET=photos
